{
  "name": "ink_transition",
  "type": "mask_expand",
  "duration": 1.2,
  "easing": "easeInCubic",
  "params": {
    "mask_image": "ink_brush_stroke.png",
    "mask_mode": "luminance",
    "start_scale": 0.0,
    "end_scale": 1.8,
    "rotation": 0,
    "blur_amount": 12,
    "color_tint": [0.9, 0.85, 0.8],
    "edge_feather": 0.15
  },
  "keyframes": [
    { "time": 0.0, "scale": 0.0, "blur": 12, "opacity": 0.0 },
    { "time": 0.3, "scale": 0.3, "blur": 16, "opacity": 0.2 },
    { "time": 0.7, "scale": 1.0, "blur": 10, "opacity": 0.8 },
    { "time": 1.0, "scale": 1.8, "blur": 4,  "opacity": 1.0 }
  ]
}